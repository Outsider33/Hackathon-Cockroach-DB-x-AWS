# Copy to .env and fill in. .env is git-ignored.
# No credential belongs in this repository, in a commit, or in a chat window.

# CockroachDB Cloud -- Console > cluster > Connect > General connection string
CRDB_URL="postgresql://<user>:<password>@<host>:26257/agentmem?sslmode=verify-full"

# AWS -- needs bedrock:InvokeModel in us-east-1
AWS_REGION="us-east-1"
BEDROCK_EMBED_MODEL="amazon.titan-embed-text-v2:0"
