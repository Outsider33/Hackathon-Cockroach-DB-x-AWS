# Copy to .env and fill in. THIS file is tracked by git. Anything starting with
# .env is ignored, and this template is the single explicit exception.
# No credential belongs in this repository, in a commit, or in a chat window.

# CockroachDB Cloud -- Console > cluster > Connect > General connection string.
# Two things that cost time: no angle brackets around the password, and the
# database name at the end is agentmem, not defaultdb.
CRDB_URL="postgresql://user:password@host:26257/agentmem?sslmode=verify-full"

# AWS, only needed for --backend bedrock.
# us-east-1 was throttled solid on 2026-08-04. Three other regions answered once
# and then throttled too, for the account root as well as a scoped IAM user.
# Bedrock capacity is per region and per model, so on ThrottlingException with a
# valid key, change region before anything else.
AWS_REGION="us-west-2"
BEDROCK_EMBED_MODEL="amazon.titan-embed-text-v2:0"
