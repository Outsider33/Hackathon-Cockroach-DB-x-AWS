# Copy to .env and fill in. THIS file is tracked by git, .env is not.
# No credential belongs in this repository, in a commit, or in a chat window.

# CockroachDB Cloud -- Console > cluster > Connect > General connection string.
# Note the database name at the end: agentmem, not defaultdb.
CRDB_URL="postgresql://user:password@host:26257/agentmem?sslmode=verify-full"

# AWS -- one region for everything. The cluster, the Lambda, the bucket and the
# HTTP API are all in us-east-1, and the database round trip stays inside it.
# This file said us-west-2 until 2026-08-09, left over from hunting a region
# where Bedrock would answer; nothing was ever deployed there.
AWS_REGION="us-east-1"

# Embeddings. Bedrock was throttled to zero on this account in us-east-1,
# us-west-2, eu-west-3 and ap-northeast-1, remeasured on 2026-08-09, so the
# vectors in the database come from the local backend instead. Bedrock capacity
# is per region and per model: on ThrottlingException with a valid key, change
# region before changing anything else.
BEDROCK_EMBED_MODEL="amazon.titan-embed-text-v2:0"

# Where the private engineering notes live, for ingest/chunker.py only. Not
# needed to run the demo, and not distributed with this repository.
# SANDRAIL_NOTES="/path/to/notes"
