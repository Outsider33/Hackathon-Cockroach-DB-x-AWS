# Credentials -- never commit these.
# Everything that starts with .env is ignored, and the template is the single
# explicit exception. A file called .env.local or .env.example.env is a normal
# thing to end up with, and it must not depend on anyone noticing.
.env*
!.env.example
*.pem
out.json

# The chunked corpus. Held back until the author decides whether the source
# engineering notes go public. Regenerate with: python ingest/chunker.py
data/chunks.jsonl

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# OS
.DS_Store
Thumbs.db
